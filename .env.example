# Copy to `.env` and fill in locally. NEVER commit `.env` or real keys.

# --- Stellar ---
# Secret key (S...) for the robot/operator account. Use TESTNET ONLY in dev.
STELLAR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Public key (G...) corresponding to STELLAR_SECRET (safe to share).
STELLAR_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# RPC endpoint. Default targets Stellar testnet.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# testnet | mainnet | futurenet | standalone | raw passphrase
STELLAR_NETWORK=testnet
# Deployed TaskEscrow contract id (C...). Demo testnet instance:
TASK_ESCROW_CONTRACT_ID=CD55XYVX5AXAJNKBKALP6AESUNA2NZHTWOCNK3QUW4EYHGTN4LIHS46X
# Stellar Asset Contract for native XLM rewards. Testnet example:
# CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
STELLAR_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Optional transaction/RPC tuning.
STELLAR_FEE=100
STELLAR_TIMEOUT_SECONDS=30
STELLAR_RPC_TIMEOUT_SECONDS=30
STELLAR_ALLOW_HTTP=false

# --- Manual testnet smoke test ---
# Distinct funded executor account for create -> accept -> proof -> release.
SMOKE_EXECUTOR_SECRET=
SMOKE_CAPABILITY=navigate
SMOKE_AMOUNT=1
SMOKE_DEADLINE_SECONDS=120

# --- ROS 2 ---
ROS_DOMAIN_ID=0
RUST_LOG=info
